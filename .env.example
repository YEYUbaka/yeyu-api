# Copy this file to .env for local development and replace every placeholder.
# Do not commit .env or any real credential.

FASTAPI_ENV=development
PROJECT_NAME=Yeyu API
API_PUBLIC_URL=http://localhost:8000
FRONTEND_HOST=http://localhost:5173
SECRET_KEY=replace-with-a-random-local-secret
API_KEY_PEPPER=replace-with-a-random-persistent-api-key-pepper
API_KEY_PEPPER_VERSION=1
# During a rotation, set both values and change the current version to a new positive number.
# API_KEY_PREVIOUS_PEPPER=replace-with-the-prior-api-key-pepper
# API_KEY_PREVIOUS_PEPPER_VERSION=replace-with-the-prior-positive-version
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-local-password

SMTP_HOST=mailpit
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=admin@example.com
SMTP_TLS=false
SMTP_PORT=1025

POSTGRES_PASSWORD=replace-with-a-local-postgres-password
DATABASE_URL=postgresql://postgres:replace-with-a-local-postgres-password@db:5432/app
REDIS_URL=redis://redis:6379/0
REDIS_LEASE_CANCEL_TOMBSTONE_TTL_SECONDS=900

GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_API_BASE_URL=https://api.github.com

VITE_API_URL=
MAILPIT_HOST=http://localhost:8025
DOMAIN=localhost
SENTRY_DSN=
